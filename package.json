{
  "name": "cst-unified-message-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:cst-rules": "node scripts/import-cst-rules.mjs",
    "import:agent-directory": "node --import ./scripts/register-hooks.mjs scripts/import-agent-directory.mjs",
    "import:agent-activity": "node --import ./scripts/register-hooks.mjs scripts/import-agent-activity.mjs",
    "import:message-media": "node --import ./scripts/register-hooks.mjs scripts/import-message-media.mjs",
    "import:sla-policy": "node --import ./scripts/register-hooks.mjs scripts/import-sla-policy.mjs",
    "sync:mysql": "node --import ./scripts/register-hooks.mjs scripts/sync-mysql-datasets.mjs",
    "knowledge:sync": "node scripts/sync-knowledge-vector-store.mjs",
    "backfill:attachments": "node scripts/backfill-attachments.mjs",
    "sync:messages": "node --import ./scripts/register-hooks.mjs scripts/sync-messages.mjs",
    "repair:bodies": "node --import ./scripts/register-hooks.mjs scripts/repair-message-bodies.mjs",
    "sync:auto": "node scripts/run-message-sync.mjs",
    "sync:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-message-sync.ps1",
    "worker:automation": "node --import ./scripts/register-hooks.mjs scripts/run-automation-worker.mjs",
    "worker:automation:once": "node --import ./scripts/register-hooks.mjs scripts/run-automation-worker.mjs --once",
    "worker:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-automation-worker.ps1",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text"
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
