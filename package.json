{
  "name": "cst-unified-message-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:cst-rules": "node scripts/import-cst-rules.mjs",
    "knowledge:sync": "node scripts/sync-knowledge-vector-store.mjs",
    "backfill:attachments": "node scripts/backfill-attachments.mjs",
    "sync:messages": "node --import ./scripts/register-hooks.mjs scripts/sync-messages.mjs",
    "sync:daily": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-daily-sync.ps1",
    "sync:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-daily-sync.ps1"
  },
  "dependencies": {
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
