# ---------------------------------------------------------------------------
# CST Unified Message System — environment template.
# PLACEHOLDERS ONLY. Never put real credentials in this file.
# Copy to .env (which is gitignored) and fill in locally.
#
# Every variable below is SERVER-SIDE ONLY. None of these names may be prefixed
# with NEXT_PUBLIC_ — that would ship credentials to the browser.
# ---------------------------------------------------------------------------

# --- Source database: live marketplace messages/orders/listings -------------
# STRICTLY READ-ONLY for this project. The application must never write here.
# Use a role with SELECT only.
SOURCE_DB_HOST=<host>
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=<source-database>
SOURCE_DB_USER=<readonly-user>
SOURCE_DB_PASSWORD=<password>

# --- Application database: CST Phase 1 application state --------------------
# Writes are permitted later, and only inside the cst_app schema.
# The schema does not exist yet and is NOT created by this scaffold.
APP_DB_HOST=<host>
APP_DB_PORT=5432
APP_DB_NAME=<app-database>
APP_DB_USER=<app-user>
APP_DB_PASSWORD=<password>
APP_DB_SCHEMA=cst_app

# --- Knowledge source: CST rule snapshot ------------------------------------
# READ-ONLY. Authority/freshness versus the "Message rules final" Google Sheet
# has NOT been settled yet; see README. Optional until that review completes.
KNOWLEDGE_DB_HOST=<host>
KNOWLEDGE_DB_PORT=5432
KNOWLEDGE_DB_NAME=<knowledge-database>
KNOWLEDGE_DB_USER=<readonly-user>
KNOWLEDGE_DB_PASSWORD=<password>

# --- OpenAI: AI draft generation (PRIMARY) ----------------------------------
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never hardcode in source.
#
# The CST knowledge lives in an OpenAI vector store and File Search retrieves
# the relevant rules per conversation, so the rule corpus is NOT sent with every
# request. Create the store with:
#
#   npm run knowledge:sync              dry run, uploads nothing
#   npm run knowledge:sync -- --apply   uploads and prints the store id
#
# Only the twelve allowlisted workbooks are uploaded — see
# lib/knowledge/knowledge-files.ts. The B2B customer file never is.
OPENAI_API_KEY=<openai-api-key>

# Without this the provider still runs, but with no CST knowledge: the draft
# states no policy and is flagged for review. It is not a silent degradation.
OPENAI_VECTOR_STORE_ID=<vector-store-id>

# Model override. Defaults to gpt-4.1 when unset. Needs a large context window
# and strict structured output.
OPENAI_MODEL=gpt-4.1

# Force one provider regardless of which keys are present: openai | gemini.
# Leave unset to prefer OpenAI and fall back to Gemini.
# DRAFT_PROVIDER=openai

# --- Gemini: AI draft generation (FALLBACK) ---------------------------------
# Kept as the fallback path. Gemini has no retrieval service here, so it is
# handed the whole rule corpus inline — about 127,000 tokens per draft, which
# is why OpenAI + File Search is preferred.
# SERVER-SIDE ONLY. Read exclusively by `lib/config/env.ts`, which is marked
# `server-only`, so importing it from a client component is a build error.
# Never prefix this with NEXT_PUBLIC_, and never hardcode it in source.
#
# Optional: leave unset and draft generation reports itself unconfigured
# instead of failing. Everything else in the application works without it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=<gemini-api-key>

# Model override. Defaults to gemini-3.6-flash when unset.
GEMINI_MODEL=gemini-3.6-flash
