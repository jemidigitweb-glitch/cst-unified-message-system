# ---------------------------------------------------------------------------
# CST Unified Message System — environment template.
# PLACEHOLDERS ONLY. Never put real credentials in this file.
# Copy to .env (which is gitignored) and fill in locally.
#
# All three database roles below are SERVER-SIDE ONLY. None of these names may
# be prefixed with NEXT_PUBLIC_ — that would ship credentials to the browser.
# ---------------------------------------------------------------------------

# --- Source database: live marketplace messages/orders/listings -------------
# STRICTLY READ-ONLY for this project. The application must never write here.
# Use a role with SELECT only.
SOURCE_DB_HOST=<host>
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=<source-database>
SOURCE_DB_USER=<readonly-user>
SOURCE_DB_PASSWORD=<password>

# --- Application database: CST Phase 1 application state --------------------
# Writes are permitted later, and only inside the cst_app schema.
# The schema does not exist yet and is NOT created by this scaffold.
APP_DB_HOST=<host>
APP_DB_PORT=5432
APP_DB_NAME=<app-database>
APP_DB_USER=<app-user>
APP_DB_PASSWORD=<password>
APP_DB_SCHEMA=cst_app

# --- Knowledge source: CST rule snapshot ------------------------------------
# READ-ONLY. Authority/freshness versus the "Message rules final" Google Sheet
# has NOT been settled yet; see README. Optional until that review completes.
KNOWLEDGE_DB_HOST=<host>
KNOWLEDGE_DB_PORT=5432
KNOWLEDGE_DB_NAME=<knowledge-database>
KNOWLEDGE_DB_USER=<readonly-user>
KNOWLEDGE_DB_PASSWORD=<password>
