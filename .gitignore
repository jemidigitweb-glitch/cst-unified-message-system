# ---------------------------------------------------------------------------
# Environment / secrets — never commit.
# Real credentials for the read-only source DB and the application DB live in
# .env only. .env.example is the placeholder-only template and IS committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# Database / API credentials
*.pem
*.key
credentials.json
secrets.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# CST rule source documents. The business owns these; the repo holds their
# extracted rules in cst_app, not the documents themselves. "B2B customers.xlsx"
# also carries customer contact data, which must never be committed.
#
# BOTH CASINGS, deliberately. The folder is `knowledge-source` on disk and this
# pattern said `Knowledge-source`; it matched only because Windows compares
# paths case-insensitively. On a case-sensitive checkout the customer workbook
# would have been committed. A one-line pattern is not worth that risk.
/Knowledge-source/
/knowledge-source/

.vercel

# Rendered knowledge documents, produced by `npm run knowledge:sync` for review
# before upload. Derived from the gitignored workbooks, so equally not committed.
/.knowledge-build/

# Scheduler output. Local operational logs, not source.
/logs/

# Local analysis artefacts. These are pulled from the read-only source database
# for human inspection and routinely contain REAL order numbers, SKUs and
# prices, so they must never be committed. `tests/guards/no-customer-data.test.ts`
# scans `git ls-files`, and a real order number reaching that list is exactly
# what it is there to stop — but the guard only sees a file once it is tracked,
# so an ignore rule is what actually keeps one out.
/tmp/
