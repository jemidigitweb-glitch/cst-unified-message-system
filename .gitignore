# ---------------------------------------------------------------------------
# Environment / secrets — never commit.
# Real credentials for the read-only source DB and the application DB live in
# .env only. .env.example is the placeholder-only template and IS committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# Database / API credentials
*.pem
*.key
credentials.json
secrets.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# CST rule source documents. The business owns these; the repo holds their
# extracted rules in cst_app, not the documents themselves. "B2B customers.xlsx"
# also carries customer contact data, which must never be committed.
#
# BOTH CASINGS, deliberately. The folder is `knowledge-source` on disk and this
# pattern said `Knowledge-source`; it matched only because Windows compares
# paths case-insensitively. On a case-sensitive checkout the customer workbook
# would have been committed. A one-line pattern is not worth that risk.
/Knowledge-source/
/knowledge-source/

.vercel
